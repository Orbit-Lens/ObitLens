# OrbitLens Web Backend Environment Configuration

PORT=5000
NODE_ENV=development

# Database Configuration (Defaults to local MongoDB; falls back to embedded MongoMemoryServer if unavailable)
MONGODB_URI=mongodb://localhost:27017/orbitlens

# JWT Security Secrets (Minimum 32 characters required)
JWT_ACCESS_SECRET=orbitlens_dev_jwt_access_secret_key_32_characters_long_super_secure
JWT_REFRESH_SECRET=orbitlens_dev_jwt_refresh_secret_key_32_characters_long_super_secure
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Client URLs & CORS
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AES-256-GCM Symmetric Encryption Key (32 bytes = 64 hex chars or 32 chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Redis Connection (Defaults to local Redis; falls back to direct HTTP dispatch if unavailable)
REDIS_URL=redis://localhost:6379

# Storage - AWS S3 or Local MinIO
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=orbitlens-imagery
S3_ACCESS_KEY_ID=test-access-key
S3_SECRET_ACCESS_KEY=test-secret-key
S3_REGION=ap-south-1
S3_FORCE_PATH_STYLE=false

# Internal Processing Service (Python FastAPI)
PROCESSING_SERVICE_URL=http://localhost:8000
PROCESSING_SERVICE_API_KEY=shared_internal_orbitlens_secret_key_123
