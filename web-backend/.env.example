# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────────
# Local:      mongodb://localhost:27017/orbitlens
# Production: mongodb+srv://<user>:<pass>@cluster.mongodb.net/orbitlens
MONGODB_URI=mongodb://localhost:27017/orbitlens

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "require('crypto').randomBytes(32).toString('hex') |> console.log"
JWT_ACCESS_SECRET=replace_with_64_char_hex_generated_locally
JWT_REFRESH_SECRET=replace_with_different_64_char_hex_generated_locally
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth (optional — leave blank to disable Google login) ─────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ── Frontend URL (for OAuth redirects and CORS) ───────────────────────────────
CLIENT_URL=http://localhost:5173

# ── CORS (comma-separated list of allowed origins) ───────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Encryption (AES-256-GCM for OAuth tokens stored at rest) ─────────────────
# Must be exactly 64 hex chars (32 bytes). DIFFERENT from JWT secrets.
ENCRYPTION_KEY=replace_with_64_char_hex_generated_locally

# ── Redis / Job Queue (shared with processing-service) ───────────────────────
REDIS_URL=redis://localhost:6379

# ── Object Storage — MinIO for local dev (switch to AWS S3 for production) ───
# MinIO (docker compose):
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=orbitlens-imagery
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
# AWS S3 (production): remove S3_ENDPOINT, set real credentials
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=...
# S3_REGION=ap-south-1

# ── Processing Service ────────────────────────────────────────────────────────
PROCESSING_SERVICE_URL=http://localhost:8000
# Use a high-entropy random string — shared with processing-service INTERNAL_API_KEY
PROCESSING_SERVICE_API_KEY=shared_internal_service_key_replace_me

# ── Email (Nodemailer) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your_smtp_api_key
EMAIL_FROM=noreply@orbitlens.app

# ── Monitoring (optional — leave blank to disable Sentry) ────────────────────
SENTRY_DSN=https://your_sentry_dsn_here
