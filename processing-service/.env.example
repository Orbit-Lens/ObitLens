# processing-service/.env.example
# All variables required unless marked (optional).
# Never commit .env — only .env.example.

ENV=development
PORT=8000

# Redis — shared with web-backend
REDIS_URL=redis://localhost:6379

# Object Storage — MinIO for local dev, AWS S3 for production
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=orbitlens-imagery
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

# Internal API key — must match PROCESSING_SERVICE_API_KEY in web-backend .env
INTERNAL_API_KEY=shared_internal_service_key_replace_me

# Callback URL — web-backend endpoint for processing service to post job updates
WEB_BACKEND_CALLBACK_URL=http://localhost:5000/api/v1/jobs/callback
WEB_BACKEND_CALLBACK_KEY=shared_internal_service_key_replace_me

# Matcher configuration
DEFAULT_MATCHER=classical        # classical | learned
USE_GPU=false                    # true if a CUDA device is available

# Learned matcher model (optional — not needed for classical matcher)
# MODEL_WEIGHTS_URI=s3://orbitlens-models/lightglue_weights_v1.pth

# Monitoring (optional)
SENTRY_DSN=https://your_sentry_dsn_here
