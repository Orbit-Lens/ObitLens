# ── Node dependencies ─────────────────────────────────────────────────────────
node_modules/

# ── Python virtual environment / cache ───────────────────────────────────────
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ── Environment & secrets — NEVER commit (only .env.example is allowed) ───────
.env
.env.*
!.env.example

# ── Private keys and common secret filenames ─────────────────────────────────
*.pem
*.key
id_rsa
id_ed25519
*.p12
*.pfx

# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ── Logs & coverage ──────────────────────────────────────────────────────────
*.log
coverage/
.nyc_output/
.pytest_cache/
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Large imagery / model weights — use object storage, not git ───────────────
*.img
*.tif
*.tiff
*.pth
*.onnx
*.pt
data/raw/
data/processed/

# ── OS / editor noise ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
